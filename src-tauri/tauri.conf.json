{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sound Deck",
  "version": "1.0.1",
  "identifier": "app.sounddeck.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Sound Deck",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": false,
        "decorations": true,
        "dragDropEnabled": true,
        "url": "index.html"
      },
      {
        "label": "overlay",
        "title": "Sound Deck Overlay",
        "width": 520,
        "height": 460,
        "resizable": false,
        "center": true,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": false,
        "focus": false,
        "dragDropEnabled": false,
        "url": "overlay.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost blob: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/images/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Soundboard con overlay y biblioteca local",
    "longDescription": "Sound Deck es una soundboard de escritorio local-first con overlay global, biblioteca de audios, paginas de nueve botones y busqueda en proveedores online.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"],
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
