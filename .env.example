# Sound Deck — variables de entorno de ejemplo.
#
# Copia este archivo como `.env` si necesitas alguna de estas opciones.
# `.env` esta en `.gitignore` y nunca debe subirse al repositorio.
#
# IMPORTANTE: la API key de los proveedores NO se configura aca.
# Se carga desde la aplicacion (Ajustes > Proveedores) y se guarda en la base
# de datos local, dentro de tu carpeta de datos de usuario.

# Nivel de detalle de los logs. Sobrescribe el configurado en la aplicacion.
# Valores: error | warn | info | debug | trace
# Tambien acepta la sintaxis completa de `tracing` (ej. sound_deck_lib=debug,reqwest=warn).
SOUND_DECK_LOG=info

# Host alternativo para el servidor de desarrollo de Vite.
# Solo hace falta para probar en otra maquina de la red local.
# TAURI_DEV_HOST=192.168.1.50
